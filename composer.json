{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.9|^8.0",
        "inertiajs/inertia-laravel": "^3.0",
        "intervention/image": "^4.4",
        "itsgoingd/clockwork": "^5.3",
        "joelbutcher/laravel-archivable": "^1.13",
        "lacodix/laravel-model-filter": "^4.11",
        "laravel/framework": "^13.23",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "laraveldaily/laravel-invoices": "^4.2",
        "overtrue/laravel-favorite": "^6.0",
        "owen-it/laravel-auditing": "^14.0",
        "pusher/pusher-php-server": "^7.3",
        "spatie/eloquent-sortable": "^5.0",
        "spatie/laravel-permission": "^8.4",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php scripts/php85-pest-reflection.php"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}